# Copy to .env.local to override. Never put private keys or secrets here: every
# VITE_* value is bundled into the public JavaScript.

# BSC Testnet RPC used for all reads. Defaults to a public endpoint in src/config.ts;
# check it against the official BNB Chain docs.
VITE_RPC_URL=

# Optional: point the UI at a local test deployment instead of the testnet contract.
VITE_CAJO_ADDRESS=
